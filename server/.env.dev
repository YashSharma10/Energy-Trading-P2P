# Development Environment
NODE_ENV=dev
PORT=3000

# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/carbonease-dev

# JWT
JWT_SECRET=your-dev-secret-key-min-32-chars
JWT_EXPIRY=7d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=dev@carbonease.com
EMAIL_PASS=your-dev-app-password
EMAIL_FROM=dev@carbonease.com

# Rate Limiting
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_MS=900000

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# Frontend URL (for CORS and redirects)
FRONTEND_URL=https://dev.carbonease.com

# AI Configuration (Gemini)
GEMINI_API_KEY=your-dev-gemini-api-key
