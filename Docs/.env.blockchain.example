# ===== BLOCKCHAIN CONFIGURATION =====
# Uncomment and fill in these values to enable blockchain payments

# RPC Provider URL (Sepolia Testnet example)
BLOCKCHAIN_RPC_URL=https://rpc.sepolia.org

# Smart Contract Address (after deployment)
# CONTRACT_ADDRESS=0x...

# USDC Token Address on the network
# USDC_ADDRESS=0xA2025B15a1757Df8Ab41e8613A28C6Cce56cebbA  # Sepolia USDC example

# Private Key for transaction signing (NEVER commit to version control!)
# BLOCKCHAIN_PRIVATE_KEY=0x...

# Network Configuration (default: 11155111 for Sepolia)
BLOCKCHAIN_NETWORK_ID=11155111

# Platform Fee Percentage (0-10)
BLOCKCHAIN_PLATFORM_FEE=2

# ===== EXISTING CONFIGURATION =====
# ... rest of your .env variables
